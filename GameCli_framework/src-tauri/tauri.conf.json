{
    "$schema":  "https://schema.tauri.app/config/2",
    "productName":  "随不的我",
    "version":  "0.1.0",
    "identifier":  "com.agentvn.hidden.growth",
    "build":  {
                  "beforeDevCommand":  "npm run dev",
                  "devUrl":  "http://127.0.0.1:6868",
                  "beforeBuildCommand":  "",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "windows":  [
                                {
                                    "title":  "随不的我",
                                    "width":  1280,
                                    "height":  720,
                                    "minWidth":  960,
                                    "minHeight":  540,
                                    "fullscreen":  true,
                                    "maximized":  false,
                                    "resizable":  false,
                                    "maximizable":  false,
                                    "minimizable":  false,
                                    "decorations":  false
                                }
                            ],
                "security":  {
                                 "csp":  null,
                                 "assetProtocol":  {
                                                       "enable":  true,
                                                       "scope":  [
                                                                     "**"
                                                                 ]
                                                   }
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/icon.ico"
                            ],
                   "resources":  {
                                     "resources/embedded-cartridge":  "embedded-cartridge"
                                 },
                   "windows":  {
                                   "wix":  {
                                               "language":  [
                                                                "zh-CN",
                                                                "en-US"
                                                            ]
                                           },
                                   "nsis":  {
                                                "languages":  [
                                                                  "SimpChinese",
                                                                  "English"
                                                              ],
                                                "displayLanguageSelector":  true
                                            }
                               },
                   "android":  {
                                   "versionCode":  1
                               }
               }
}
