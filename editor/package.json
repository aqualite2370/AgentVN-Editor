{
  "name": "agentvn-editor",
  "version": "1.9.50",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE",
  "type": "module",
  "scripts": {
    "build:gamecli-preview": "npm --prefix ../GameCli_framework run build",
    "prepare:runtime-resources": "powershell -NoProfile -ExecutionPolicy Bypass -File ../scripts/prepare-editor-runtime-resources.ps1",
    "dev": "npm run build:gamecli-preview && vite --host 127.0.0.1 --port 6767",
    "typecheck": "tsc --noEmit",
    "prebuild": "node ../scripts/build-agent-doc-index.cjs",
    "build": "npm run build:gamecli-preview && tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "acceptance:show-image-event": "node ../scripts/show-image-command-acceptance.cjs",
    "acceptance:model-streaming": "node ../scripts/model-streaming-audit.cjs",
    "acceptance:package-layout": "node ../scripts/package-export-layout-audit.cjs",
    "acceptance:novel-layout": "node ../scripts/novel-import-layout-audit.cjs",
    "acceptance:novel-job-creation": "node ../scripts/novel-process-job-creation-acceptance.cjs",
    "acceptance:subagent-motion": "node ../scripts/subagent-detail-motion-audit.cjs",
    "acceptance:advanced-layout-transition": "node ../scripts/advanced-layout-transition-audit.cjs",
    "acceptance:asset-generation": "node ../scripts/asset-generation-acceptance.cjs",
    "acceptance:layout-runtime": "node ../scripts/layout-runtime-acceptance.cjs",
    "acceptance:client-layout-options": "node ../scripts/client-layout-options-acceptance.cjs",
    "acceptance:no-video": "node ../scripts/non-ai-smoke-audit.cjs",
    "audit:hover-help": "node ../scripts/audit-hover-help.cjs",
    "audit:zh-copy": "node ../scripts/audit-editor-zh-copy.cjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "@xyflow/react": "^12.6.0",
    "fontkit": "^2.0.4",
    "jszip": "^3.10.1",
    "liquid-glass-react": "^1.1.1",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.0.9",
    "react": "^19.2.8",
    "react-colorful": "^5.7.0",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.60.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  }
}
